{
  "name": "cat-paw-trails",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsc -p tsconfig.core.json && node --test tests/*.test.mjs",
    "build:offline": "tsc --noEmit && vite build --config vite.offline.config.ts && node tools/package_offline.mjs",
    "levels:validate": "tsc -p tsconfig.core.json && node tools/validate_levels.mjs"
  },
  "devDependencies": {
    "typescript": "5.7.3",
    "vite": "6.1.0"
  }
}
